CREATE TABLE `users` (
  `id` int AUTO_INCREMENT PRIMARY KEY,
  `username` varchar(32) NOT NULL UNIQUE,
  `email` varchar(128) NOT NULL,
  `password_hash` char(32) NOT NULL,
  `role` enum('customer','admin') DEFAULT 'customer'
);

